  "code": "from fastmcp.server import FastMCP\nimport math\n\n# Create sub-server with math tools\nmath_server = FastMCP(\"math-server\")\n\n@math_server.tool()\ndef add(a: float, b: float) -> float:\n    \"\"\"Add two numbers.\"\"\"\n    return a + b\n\n@math_server.tool()\ndef multiply(a: float, b: float) -> float:\n    \"\"\"Multiply two numbers.\"\"\"\n    return a * b\n\n@math_server.tool()\ndef sqrt(x: float) -> float:\n    \"\"\"Calculate square root.\"\"\"\n    return math.sqrt(x)\n\n# Create main server\nmain_server = FastMCP(\"main-server\")\n\n# Mount math server with \"math\" namespace/prefix\nmain_server.mount(math_server, namespace=\"math\")\n\nif __name__ == \"__main__\":\n    main_server.run()",
