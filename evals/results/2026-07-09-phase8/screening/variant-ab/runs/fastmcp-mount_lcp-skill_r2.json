  "code": "from fastmcp.server import FastMCP\n\n# Create a sub-server that provides math tools\nmath_server = FastMCP(\"math-tools\")\n\n@math_server.tool()\ndef add(a: int, b: int) -> int:\n    \"\"\"Add two numbers together.\"\"\"\n    return a + b\n\n@math_server.tool()\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Multiply two numbers together.\"\"\"\n    return a * b\n\n@math_server.tool()\ndef subtract(a: int, b: int) -> int:\n    \"\"\"Subtract b from a.\"\"\"\n    return a - b\n\n# Create the main server\nmain_server = FastMCP(\"main-server\")\n\n@main_server.tool()\ndef greet(name: str) -> str:\n    \"\"\"Greet someone by name.\"\"\"\n    return f\"Hello, {name}!\"\n\n# Mount the math sub-server under the \"math\" namespace\n# This makes tools available as \"math_add\", \"math_multiply\", \"math_subtract\"\nmain_server.mount(math_server, namespace=\"math\")\n\nif __name__ == \"__main__\":\n    main_server.run()",
  "result_text": "```python\nfrom fastmcp.server import FastMCP\n\n# Create a sub-server that provides math tools\nmath_server = FastMCP(\"math-tools\")\n\n@math_server.tool()\ndef add(a: int, b: int) -> int:\n    \"\"\"Add two numbers together.\"\"\"\n    return a + b\n\n@math_server.tool()\ndef multiply(a: int, b: int) -> int:\n    \"\"\"Multiply two numbers together.\"\"\"\n    return a * b\n\n@math_server.tool()\ndef subtract(a: int, b: int) -> int:\n    \"\"\"Subtract b from a.\"\"\"\n    return a - b\n\n# Create the main server\nmain_server = FastMCP(\"main-server\")\n\n@main_server.tool()\ndef greet(name: str) -> str:\n    \"\"\"Greet someone by name.\"\"\"\n    return f\"Hello, {name}!\"\n\n# Mount the math sub-server under the \"math\" namespace\n# This makes tools available as \"math_add\", \"math_multiply\", \"math_subtract\"\nmain_server.mount(math_server, namespace=\"math\")\n\nif __name__ == \"__main__\":\n    main_server.run()\n```",
